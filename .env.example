EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional OSRM-compatible routing service URL. The public demo endpoint is
# used when empty; configure a production-grade provider before release.
EXPO_PUBLIC_OSRM_BASE_URL=
# Optional: OpenStreetMap XYZ raster tile template. Leave empty to use the
# community OpenStreetMap tiles for development. Must be HTTPS and contain
# {z}, {x} and {y}. Use your own or a commercial OSM-derived tile service for
# production traffic; see docs/maps-setup.md.
EXPO_PUBLIC_OSM_TILE_URL=
# Optional: emergency SMS recipient used by the SOS screen. Leave empty to keep
# the SOS alert on-device (the default). RESQ Nepal never invents an emergency
# number and never sends an SMS without the user pressing send themselves.
EXPO_PUBLIC_SOS_SMS_NUMBER=
# Enable demo mode (set to "true" to run the app without real SMS/OTP delivery).
# The demo OTP "1234" is accepted only in demo mode. Demo mode is local-only:
# no real account is created and no Supabase writes are performed on the demo
# flow. Never enable this in a production build.
EXPO_PUBLIC_DEMO_MODE=
# Keep disabled until the active-trip tracking RLS migration is reviewed and
# applied to the target Supabase project. This toggle does not replace RLS.
EXPO_PUBLIC_SECURE_TRIP_TRACKING_ENABLED=
