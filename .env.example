EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: emergency SMS recipient used by the SOS screen. Leave empty to keep
# the SOS alert on-device (the default). RESQ Nepal never invents an emergency
# number and never sends an SMS without the user pressing send themselves.
EXPO_PUBLIC_SOS_SMS_NUMBER=
# Enable demo mode (set to "true" to run the app without real SMS/OTP delivery).
# The demo OTP "1234" is accepted only in demo mode. Demo mode is local-only:
# no real account is created and no Supabase writes are performed on the demo
# flow. Never enable this in a production build.
EXPO_PUBLIC_DEMO_MODE=
