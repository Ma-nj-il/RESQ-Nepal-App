{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/safety/safety.incident.resolved/v1/schema.json",
  "title": "safety.incident.resolved.v1",
  "description": "An authorized responder recorded the terminal incident outcome.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "required": ["tenantId", "facilityId"],
      "properties": {
        "eventType": {
          "const": "safety.incident.resolved.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-safety"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "safetyIncident"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "safetyIncident"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "escalationTier", "outcomeCode"],
          "properties": {
            "status": {
              "const": "RESOLVED"
            },
            "escalationTier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "outcomeCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
            }
          }
        }
      }
    }
  ]
}
