{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/safety/safety.incident.escalated/v1/schema.json",
  "title": "safety.incident.escalated.v1",
  "description": "The incident advanced to a higher escalation tier.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "safety.incident.escalated.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-safety", "core-safety-worker"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "safetyIncident"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "safetyIncident"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "escalationTier", "outcomeCode"],
          "properties": {
            "status": {
              "const": "ESCALATED"
            },
            "escalationTier": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "outcomeCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
            }
          }
        }
      }
    }
  ]
}
