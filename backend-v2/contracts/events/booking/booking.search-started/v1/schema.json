{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/booking/booking.search-started/v1/schema.json",
  "title": "booking.search-started.v1",
  "description": "Eligible provider offers and the search deadline were created.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "booking.search-started.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-dispatch"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "booking"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "bookingDispatch"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "offerCount"],
          "properties": {
            "status": {
              "const": "SEARCHING"
            },
            "offerCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  ]
}
