{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/booking/booking.cancelled/v1/schema.json",
  "title": "booking.cancelled.v1",
  "description": "A booking and any linked active trip were atomically cancelled.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "booking.cancelled.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-dispatch"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "booking"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "bookingDispatch"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasonCode"],
          "properties": {
            "status": {
              "const": "CANCELLED"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
            }
          }
        }
      }
    }
  ]
}
