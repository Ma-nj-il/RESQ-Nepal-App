{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/dispatch/dispatch.assignment.released/v1/schema.json",
  "title": "dispatch.assignment.released.v1",
  "description": "The assignment resources were released after terminal trip handling.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "required": ["tenantId", "facilityId"],
      "properties": {
        "eventType": {
          "const": "dispatch.assignment.released.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-dispatch"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "assignment"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "bookingDispatch"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasonCode"],
          "properties": {
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
            }
          }
        }
      }
    }
  ]
}
