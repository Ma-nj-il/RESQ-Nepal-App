{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.resq-nepal.org/events/trip/trip.arrived-at-destination/v1/schema.json",
  "title": "trip.arrived-at-destination.v1",
  "description": "The crew arrived at the destination.",
  "allOf": [
    {
      "$ref": "https://contracts.resq-nepal.org/events/_shared/envelope/v1/schema.json"
    },
    {
      "type": "object",
      "required": ["tenantId", "facilityId"],
      "properties": {
        "eventType": {
          "const": "trip.arrived-at-destination.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": ["core-dispatch"]
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "trip"
            }
          }
        },
        "stream": {
          "type": "object",
          "properties": {
            "type": {
              "const": "trip"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bookingId", "fromStatus", "status"],
          "properties": {
            "bookingId": {
              "type": "string",
              "format": "uuid"
            },
            "fromStatus": {
              "const": "EN_ROUTE_TO_DESTINATION"
            },
            "status": {
              "const": "ARRIVED_AT_DESTINATION"
            }
          }
        }
      }
    }
  ]
}
