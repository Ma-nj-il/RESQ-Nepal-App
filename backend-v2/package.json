{
  "name": "@resq-nepal/backend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RESQ Nepal NestJS platform foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0",
    "flatted": "3.4.4",
    "handlebars": "4.7.10",
    "lodash": "4.18.1",
    "node-forge": "1.4.2",
    "qs": "6.17.1",
    "underscore": "1.13.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev:api": "node --import tsx apps/api/main.ts",
    "dev:api:local": "node --env-file=docker/local.env --import tsx apps/api/main.ts",
    "dev:worker": "node --import tsx apps/worker/main.ts",
    "dev:worker:local": "node --env-file=docker/local.worker.env --import tsx apps/worker/main.ts",
    "dev:outbox-relay": "node --import tsx apps/outbox-relay/main.ts",
    "dev:outbox-relay:local": "node --env-file=docker/local.outbox.env --import tsx apps/outbox-relay/main.ts",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:outbox-relay": "node dist/apps/outbox-relay/main.js",
    "migration:run": "node --import tsx apps/migration/main.ts",
    "migration:run:local": "node --env-file=docker/local.env --import tsx apps/migration/main.ts",
    "migration:run:compiled": "node dist/apps/migration/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit --coverage --runInBand",
    "architecture": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit --runInBand test/unit/architecture.spec.ts",
    "postman:health": "node --require ./tools/newman-faker-compat.cjs ./node_modules/newman/bin/newman.js run postman/health.postman_collection.json -e postman/local.postman_environment.json --bail",
    "postman:identity": "node --require ./tools/newman-faker-compat.cjs ./node_modules/newman/bin/newman.js run postman/identity-access.postman_collection.json -e postman/local.postman_environment.json --bail",
    "postman:provider-operations": "node --require ./tools/newman-faker-compat.cjs ./node_modules/newman/bin/newman.js run postman/provider-operations.postman_collection.json -e postman/local.postman_environment.json --bail",
    "postman:health:outage": "npm run postman:health -- --env-var expectedReadinessStatus=503",
    "docker:config": "docker compose config --quiet",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.71.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@prometheus-io/client": "0.16.1",
    "argon2": "0.45.2",
    "bullmq": "6.5.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "kafkajs": "2.2.4",
    "nestjs-pino": "5.3.1",
    "opossum": "10.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/opossum": "8.1.9",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "newman": "6.2.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
