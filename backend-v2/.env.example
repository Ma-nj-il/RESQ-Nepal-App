# Copy values into your secret/config system. Do not commit a populated .env.
NODE_ENV=development
RESQ_RELEASE=local-dev
RESQ_LOG_LEVEL=info
RESQ_LOG_PRETTY=true
RESQ_HTTP_HOST=0.0.0.0
RESQ_HTTP_PORT=3000
RESQ_HEALTH_PORT=3001
RESQ_SHUTDOWN_GRACE_MS=15000
RESQ_DEPENDENCY_TIMEOUT_MS=1500
RESQ_DATABASE_URL=postgresql://resq_api:replace-me@localhost:5432/resq
RESQ_MIGRATION_DATABASE_URL=postgresql://resq_migrator:replace-me@localhost:5432/resq
RESQ_DATABASE_SSL_MODE=disable
RESQ_DATABASE_POOL_MAX=10
RESQ_REDIS_CACHE_URL=redis://localhost:6379/0
RESQ_REDIS_QUEUE_URL=redis://localhost:6380/0
RESQ_KAFKA_BROKERS=localhost:9092
RESQ_KAFKA_SSL=false
# Production requires all three SASL values, supplied by the secret/config system.
# RESQ_KAFKA_SASL_MECHANISM=scram-sha-512
# RESQ_KAFKA_SASL_USERNAME=replace-me
# RESQ_KAFKA_SASL_PASSWORD=replace-me
RESQ_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Optional private S3 document adapter. Configure all three values together through secret management.
# RESQ_DOCUMENT_BUCKET=resq-documents
# RESQ_DOCUMENT_ACCESS_KEY_ID=replace-me
# RESQ_DOCUMENT_SECRET_ACCESS_KEY=replace-me
# RESQ_DOCUMENT_REGION=us-east-1
# RESQ_DOCUMENT_SESSION_TOKEN=replace-me
# RESQ_DOCUMENT_KMS_KEY_ID=managed-key-id-required-in-production
# ClamAV uses a shared Unix socket, with INSTREAM enabled and current signatures.
# RESQ_DOCUMENT_CLAMD_SOCKET=/run/clamav/clamd.sock
# RESQ_DOCUMENT_TIMEOUT_MS=30000
RESQ_CORS_ORIGINS=http://localhost:8081
RESQ_REALTIME_ENABLED=false
RESQ_METRICS_ENABLED=true
RESQ_OTEL_ENABLED=false
RESQ_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Migration releases must set these explicitly in production. Keep the expected version unset for
# repeatable local runs, or set it on the command line when proving a known upgrade boundary.
# RESQ_MIGRATION_EXPECTED_CURRENT=NONE
# RESQ_MIGRATION_OPERATOR=release-job-reference
