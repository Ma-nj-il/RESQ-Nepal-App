    {
      "name": "Request synthetic local owner OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/otp-challenges",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "otp-challenges"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"+9779800000003\",\n  \"purpose\": \"REGISTRATION_OR_LOGIN\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accepts the owner challenge', function () { pm.response.to.have.status(202); });",
              "const body = pm.response.json();",
              "pm.expect(JSON.stringify(body)).not.to.include('424242');",
              "pm.collectionVariables.set('ownerChallengeId', body.data.challengeId);",
              "pm.collectionVariables.set('safetyIdempotencyKey', `phase5-safety-${body.data.challengeId}`);"
            ]
          }
        }
      ]
    },
