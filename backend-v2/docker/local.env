# Synthetic local-only values. Never copy these credentials to a shared environment.
NODE_ENV=development
RESQ_RELEASE=local
RESQ_LOG_LEVEL=debug
RESQ_LOG_PRETTY=true
RESQ_HTTP_HOST=127.0.0.1
RESQ_HTTP_PORT=3000
RESQ_HEALTH_PORT=3000
RESQ_DEPENDENCY_TIMEOUT_MS=1500
RESQ_DATABASE_URL=postgresql://resq_api:resq-api-local@localhost:5432/resq
RESQ_MIGRATION_DATABASE_URL=postgresql://resq_migrator:resq-migrator-local@localhost:5432/resq
RESQ_DATABASE_SSL_MODE=disable
RESQ_DATABASE_POOL_MAX=10
RESQ_REDIS_CACHE_URL=redis://localhost:6379/0
RESQ_REDIS_QUEUE_URL=redis://localhost:6380/0
RESQ_KAFKA_BROKERS=localhost:9092
RESQ_KAFKA_SSL=false
RESQ_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
RESQ_CORS_ORIGINS=http://localhost:8081,http://localhost:3000
RESQ_METRICS_ENABLED=true
RESQ_OTEL_ENABLED=false
RESQ_MIGRATION_OPERATOR=local-developer
RESQ_AUTH_FIXED_DEVELOPMENT_OTP=424242
