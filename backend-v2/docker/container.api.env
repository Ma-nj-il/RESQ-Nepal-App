NODE_ENV=development
RESQ_RELEASE=local-container
RESQ_LOG_LEVEL=info
RESQ_LOG_PRETTY=false
RESQ_HTTP_HOST=0.0.0.0
RESQ_HTTP_PORT=3000
RESQ_HEALTH_PORT=3000
RESQ_DEPENDENCY_TIMEOUT_MS=2000
RESQ_DATABASE_URL=postgresql://resq_api:resq-api-local@postgres:5432/resq
RESQ_DATABASE_SSL_MODE=disable
RESQ_DATABASE_POOL_MAX=10
RESQ_REDIS_CACHE_URL=redis://redis-cache:6379/0
RESQ_REDIS_QUEUE_URL=redis://redis-queue:6379/0
RESQ_KAFKA_BROKERS=kafka:19092
RESQ_KAFKA_SSL=false
RESQ_OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
RESQ_CORS_ORIGINS=http://localhost:8081,http://localhost:3000
RESQ_METRICS_ENABLED=true
RESQ_OTEL_ENABLED=false
RESQ_AUTH_FIXED_DEVELOPMENT_OTP=424242
