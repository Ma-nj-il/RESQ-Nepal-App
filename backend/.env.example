# Server Configuration
PORT=8080
ENVIRONMENT=development
VERSION=1.0.0

# Database Configuration (localhost-friendly)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=medi-ambulance
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis Configuration (localhost-friendly)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24

# Service URLs (for inter-service communication)
PROMOS_SERVICE_URL=http://localhost:8089
ML_ETA_SERVICE_URL=http://localhost:8093

# OpenTelemetry Configuration (optional)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317



# Business Logic Configuration
COMMISSION_RATE=0.20                 # Platform commission rate (default: 0.20 = 20%)
CANCELLATION_FEE_RATE=0.10           # Cancellation fee rate (default: 0.10 = 10%)

# Firebase Configuration (Notifications Service - optional)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_ENABLED=false

# Twilio Configuration (Notifications Service - optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP Configuration (Notifications Service - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@richxcame.com
SMTP_FROM_NAME=medi-ambulance

# Circuit Breaker Configuration
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=1
CB_TIMEOUT_SECONDS=30
CB_INTERVAL_SECONDS=60

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_BURST=40
RATE_LIMIT_WINDOW_SECONDS=60

# Server Timeouts
READ_TIMEOUT=10
WRITE_TIMEOUT=10

# Timeout Configuration
HTTP_CLIENT_TIMEOUT=30              # HTTP client timeout in seconds (default: 30)
DB_QUERY_TIMEOUT=10                 # Database query timeout in seconds (default: 10)
REDIS_OPERATION_TIMEOUT=5           # Redis operation timeout in seconds (default: 5, fallback if read/write not set)
REDIS_READ_TIMEOUT=5                # Redis read timeout in seconds (default: 5)
REDIS_WRITE_TIMEOUT=5               # Redis write timeout in seconds (default: 5)
WS_CONNECTION_TIMEOUT=60            # WebSocket connection timeout in seconds (default: 60)
DEFAULT_REQUEST_TIMEOUT=30          # Default HTTP request timeout in seconds (default: 30)
ROUTE_TIMEOUT_OVERRIDES=            # Optional: JSON map of route-specific timeouts (e.g., '{"POST:/api/v1/rides": 60, "GET:/api/v1/analytics/reports": 120}')

# Google Pub/Sub Configuration (optional)
PUBSUB_PROJECT_ID=
PUBSUB_ENABLED=false

# Internal API Key (for inter-service communication)
INTERNAL_API_KEY=change-me-in-production

# NATS Configuration (Event Bus)
NATS_URL=nats://localhost:4222

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Verification Service
VERIFICATION_API_URL=
VERIFICATION_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Anonymous Rate Limiting
RATE_LIMIT_ANONYMOUS_LIMIT=30
RATE_LIMIT_ANONYMOUS_BURST=10
RATE_LIMIT_REDIS_PREFIX=rl:

# NATS Event Bus
NATS_STREAM_NAME=ridehailing
NATS_ENABLED=false

# Maps Service Configuration
MAPS_ENABLED=false
MAPS_PRIMARY_PROVIDER=google
HERE_API_KEY=
MAPS_CACHE_ENABLED=true
MAPS_CACHE_TTL_SECONDS=300
MAPS_TRAFFIC_ENABLED=false
MAPS_TRAFFIC_REFRESH_SECONDS=60
MAPS_FALLBACK_HAVERSINE=true

# Database Circuit Breaker
DB_BREAKER_ENABLED=false
DB_BREAKER_FAILURE_THRESHOLD=5
DB_BREAKER_SUCCESS_THRESHOLD=1
DB_BREAKER_TIMEOUT_SECONDS=30
DB_BREAKER_INTERVAL_SECONDS=60

# JWT Key Management (optional)
JWT_KEYS_FILE=
JWT_ROTATION_HOURS=24
JWT_ROTATION_GRACE_HOURS=2
JWT_KEY_REFRESH_MINUTES=5

# Inter-Service Communication
GEO_SERVICE_URL=http://localhost:8091
REALTIME_SERVICE_URL=http://localhost:8092
NOTIFICATIONS_SERVICE_URL=http://localhost:8088

# Geocoding (optional)
GEOCODING_REGION_BIAS=
GEOCODING_LANGUAGE=en

# Background Check Integration (Checkr - optional)
CHECKR_API_KEY=
CHECKR_WEBHOOK_KEY=
CHECKR_PACKAGE=driver_pro
CHECKR_ENABLED=false

# Identity Verification (Onfido - optional)
ONFIDO_API_KEY=
ONFIDO_WEBHOOK_KEY=
ONFIDO_WORKFLOW_ID=
ONFIDO_ENABLED=false

# Secrets Management (optional)
SECRETS_PROVIDER=env
SECRETS_CACHE_TTL_SECONDS=300
SECRETS_ROTATION_DAYS=90
SECRETS_AUDIT_ENABLED=false

# Firebase Additional Configuration
FIREBASE_CREDENTIALS_JSON=



# Circuit Breaker Service Overrides (optional JSON)
CB_SERVICE_OVERRIDES=
